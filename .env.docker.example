# Docker Compose uses this file only as a template. Copy it to .env and replace every secret.
WEB_HTTP_PORT=8088
POSTGRES_DB=basketball_gm
POSTGRES_USER=basketball_gm
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
# Generate exactly 32 random bytes, then Base64 encode them.
LLM_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
FORUM_ENABLED=true
FORUM_ADMIN_USERNAMES=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
SIMULATION_RETENTION_CRON=0 0 3 * * *
SIMULATION_RETENTION_ZONE=Asia/Shanghai
