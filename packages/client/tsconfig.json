{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@dream-court/core": ["../core/src/index.ts"],
      "@dream-court/core/catalog": ["../core/src/catalog/index.ts"],
      "@catalog/*": ["../../backend/src/main/resources/*"]
    }
  },
  "include": ["src"]
}
