{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@catalog/*": ["../../backend/src/main/resources/*"],
      "@dream-court/core": ["../../packages/core/src/index.ts"],
      "@dream-court/core/catalog": ["../../packages/core/src/catalog/index.ts"],
      "@dream-court/client": ["../../packages/client/src/index.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true
  },
  "include": ["src"]
}
