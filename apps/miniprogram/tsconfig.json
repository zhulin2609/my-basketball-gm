{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "@tarojs/taro"],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "@/*": ["./src/*"],
      "@catalog/*": ["../../backend/src/main/resources/*"],
      "@dream-court/core": ["../../packages/core/src/index.ts"],
      "@dream-court/core/catalog": ["../../packages/core/src/catalog/index.ts"],
      "@dream-court/client": ["../../packages/client/src/index.ts"]
    }
  },
  "include": ["src", "config"]
}
